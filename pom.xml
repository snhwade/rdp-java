        <!--
          绉佹湁渚濊禆鎷︽埅锛圧14.5 / R14.3 / R14.4锛夛細
          maven-enforcer-plugin 鐨?bannedDependencies 瑙勫垯绂佹浠讳綍绉佹湁浠撳簱鍧愭爣锛?
          瑕嗙洊鏁翠釜 com.xgd.* 鍛藉悕绌洪棿锛堝惈浠绘剰瀛愬垎缁勪笌浼犻€掍緷璧栵級锛?
          鍛戒腑鍗虫瀯寤哄け璐ュ苟鎶ュ憡璇ュ潗鏍囥€傜埗宸ョ▼澹版槑锛屾墍鏈夊瓙妯″潡缁ф壙鎵ц銆?
          璇存槑锛歟xclude 妯″紡涓殑 `*` 鍙法 `.` 鍖归厤浠绘剰瀛楃锛涘悓鏃舵樉寮忓垪鍑烘牴鍒嗙粍 `com.xgd`
          浠ヨ鐩栧潗鏍囨伆涓烘牴鍒嗙粍鏈韩锛堟棤瀛愬垎缁勶級鐨勬儏褰€?
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-private-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- com.xgd 绉佹湁鍛藉悕绌洪棿锛氭牴鍒嗙粍鍙婂叾浠绘剰瀛愬垎缁勭殑鍏ㄩ儴鍧愭爣 -->
                                        <exclude>com.xgd</exclude>
                                        <exclude>com.xgd.*</exclude>
                                    </excludes>
                                    <message>妫€娴嬪埌绉佹湁浠撳簱渚濊禆锛坈om.xgd.*锛夛紝绂佹浣跨敤锛圧14.5锛夈€傝鏀圭敤寮€婧愭浛浠ｄ緷璧栥€?/message>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

