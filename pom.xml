                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!-- 淇濈暀鏂规硶鍙傛暟鍚嶏紝浣?Spring MVC 鐨?@PathVariable/@RequestParam
                             鍦ㄤ笉鏄惧紡鎸囧畾 name 鏃朵粛鑳芥寜鍙傛暟鍚嶇粦瀹氾紙Spring Boot 鐖?POM 榛樿寮€鍚級銆?-->
                        <parameters>true</parameters>
